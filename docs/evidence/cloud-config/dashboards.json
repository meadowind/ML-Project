    "gridLayout": {
      "columns": "2",
      "widgets": [
        {
          "title": "Rejected Rate",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "300s",
                      "perSeriesAligner": "ALIGN_PERCENTILE_50"
                    },
                    "filter": "metric.type=\"logging.googleapis.com/user/lemon-batch-rejected-rate\" resource.type=\"cloud_run_job\""
                  },
                  "unitOverride": "1"
                }
              }
            ],
            "yAxis": {
              "label": "Rejected Rate",
              "scale": "LINEAR"
            }
          }
        },
        {
          "title": "Low Confidence Rate",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "300s",
                      "perSeriesAligner": "ALIGN_PERCENTILE_50"
                    },
                    "filter": "metric.type=\"logging.googleapis.com/user/lemon-batch-low-confidence-rate\" resource.type=\"cloud_run_job\""
                  },
                  "unitOverride": "1"
                }
              }
            ],
            "yAxis": {
              "label": "Low Confidence Rate",
              "scale": "LINEAR"
            }
          }
        },
        {
          "title": "Batch Duration",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "300s",
                      "perSeriesAligner": "ALIGN_PERCENTILE_50"
                    },
                    "filter": "metric.type=\"logging.googleapis.com/user/lemon-batch-duration-seconds\" resource.type=\"cloud_run_job\""
                  },
                  "unitOverride": "s"
                }
              }
            ],
            "yAxis": {
              "label": "Seconds",
              "scale": "LINEAR"
            }
          }
        },
        {
          "title": "Successful Batch Executions",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "STACKED_BAR",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "1800s",
                      "crossSeriesReducer": "REDUCE_SUM",
